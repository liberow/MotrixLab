        <!-- Environment textures -->
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <!-- Visual options -->
    <visual>
        <headlight diffuse="0.3 0.3 0.3" ambient="0.2 0.2 0.2" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-120" elevation="-20"/>
        <quality shadowsize="0"/>
    </visual>

    <worldbody>
        <!-- Ground plane -->
        <geom name="floor" size="3 3 0.05" type="plane" material="groundplane"/>
        
        <!-- Lights -->
        <light name="top" pos="0 0 2" mode="trackcom"/>
        <light pos="0 0 4.5" dir="0 0 -1" directional="true"/>
        <light pos="0 4.5 0.6" dir="0 -1 0" directional="true"/>
        <light pos="0 -4.5 0.6" dir="0 1 0" directional="true"/>
        
        <!-- Cameras (adjusted for new layout: robot at (1,0,0), table at (-0.06,0,0)) -->
        <camera name="side_camera" pos="0.5 -1.0 0.8" xyaxes="1 0 0 0 0.5 1" mode="fixed" fovy="58"/>
        <camera name="front_camera" pos="0.5 1.0 0.8" xyaxes="-1 0 0 0 0.5 1" mode="fixed" fovy="58"/>
        <camera name="top_camera" pos="0.5 0 2.0" xyaxes="0 -1 0 1 0 0" mode="fixed" fovy="58"/>
        
        <!-- Study Table with Drawer (positioned to match Isaac Lab layout) -->
        <!-- Robot at (1,0,0), table rotated -90° so drawer pulls toward +X (toward robot) -->
        <!-- After rotation: local -Y becomes world +X (drawer pulls toward robot) -->
        <!-- Handle at table local (0, -0.36, 0.665) -> world (0.36, 0, 0.665) relative to table -->
        <!-- Table at (-0.06, 0, 0) puts handle at (0.3, 0, 0.665), matching Isaac Lab -->
        <body name="study_table" pos="-0.06 0 0" euler="0 0 -1.5708">
            <!-- studyTable_Main -->
            <body name="studyTable_Main" pos="0 0 0" childclass="body_studyTable">
                <geom class="viz_stl_Wood_studyTable" type="mesh" mesh="studyTable_Main" euler="-1.57 0 3.14"/>
                <geom type="box" size=".6 .275 .025" pos="0 0 0.735" rgba="0.8 0.9 0.7 1.0" mass="40" />
                <geom type="box" size="0.17 0.26 .05" pos="0.42 0 0.66" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.17 0.26 .05" pos="-0.42 0 0.66" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.025 0.025 0.305" pos="-0.565 0.235 0.305" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.025 0.025 0.305" pos="-0.565 -0.235 0.305" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.025 0.025 0.305" pos="0.565 0.235 0.305" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.025 0.025 0.305" pos="0.565 -0.235 0.305" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.6 0.01 0.175" pos="0 0.265 0.935" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.6 0.11 0.01" pos="0 0.165 1.1" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.01 0.11 0.175" pos="0.59 .165 .935" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.01 0.11 0.175" pos="-0.59 .165 .935" rgba="0.8 0.9 0.7 1.0" />
                <geom type="box" size="0.01 0.11 0.175" pos="0 .165 .935" rgba="0.8 0.9 0.7 1.0"/>
            </body>

            <!-- StudyTable_Drawer - the main target for the task -->
            <body name="studyTable_Drawer" pos="0 0 0.655" childclass="drawer_studyTable">
                <geom class="viz_stl_Wood_studyTable" type="mesh" mesh="studyTable_Drawer_Wood" euler="-1.57 0 3.14"/>
                <geom class="viz_stl_Metal_studyTable" type="mesh" mesh="studyTable_Drawer_Handle" euler="-1.57 0 3.14"/>
                <geom type="box" size=".24 .26 .01" pos="0 0 -0.04" rgba="0.8 0.9 0.7 1.0" mass="2" />
