<?xml version="1.0" ?>
<!-- 
Franka Cabinet Environment for MotrixLab
Franka Panda robot with parallel gripper, adapted for drawer opening task
Based on Isaac Lab's "Isaac-Franka-Cabinet-Direct-v0"
-->
<mujoco model="franka_cabinet_scene">
    
    <compiler angle="radian" autolimits="true"/>
    
    <!-- Use implicit integrator for better stability with articulated robots -->
    <!-- Smaller timestep (0.005) for numerical stability -->
    <option integrator="implicit" timestep="0.005"/>
    
    <!-- Franka Panda defaults -->
    <!-- Increased armature (0.1 -> 0.5) and damping (1 -> 5) for stability -->
    <default>
        <default class="panda">
            <material specular="0.5" shininess="0.25"/>
            <joint armature="0.5" damping="5" axis="0 0 1" range="-2.8973 2.8973"/>
            <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
            <default class="finger">
                <!-- Add small armature on finger joints for numerical regularization in MotrixSim -->
                <joint axis="0 1 0" type="slide" range="0 0.04" armature="0.01"/>
            </default>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>
            <default class="collision">
                <geom type="mesh" group="3"/>
                <default class="fingertip_pad_collision_1">
                    <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
                </default>
                <default class="fingertip_pad_collision_2">
                    <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_3">
                    <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_4">
                    <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
                </default>
                <default class="fingertip_pad_collision_5">
                    <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
                </default>
            </default>
        </default>
        
        <!-- StudyTable defaults (from studyTable_asset.xml) -->
        <default class="viz_stl_Metal_studyTable">
            <geom group="1" contype="0" conaffinity="0" type="mesh" material="M_Metal_studyTable"/>
        </default>
        <default class="viz_stl_Wood_studyTable">
            <geom group="1" contype="0" conaffinity="0" type="mesh" material="M_Wood_studyTable"/>
        </default>
        <default class="drawer_studyTable">
            <geom contype="1" conaffinity="1" group="3" rgba="1 0 0 1"/>
            <joint limited="true" damping="2" frictionloss="5" armature="0.1"/>
        </default>
        <default class="body_studyTable">
            <geom contype="1" conaffinity="1" group="4" rgba="0 1 0 1"/>
            <joint limited="true" damping="1" frictionloss="0.5" armature=".01"/>
        </default>
    </default>

    <asset>
        <!-- Franka Panda materials -->
        <material class="panda" name="white" rgba="1 1 1 1"/>
        <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
        <material class="panda" name="black" rgba="0.25 0.25 0.25 1"/>
        <material class="panda" name="green" rgba="0 1 0 1"/>
        <material class="panda" name="light_blue" rgba="0.039216 0.541176 0.780392 1"/>
        
        <!-- StudyTable materials and textures (from studyTable_asset.xml) -->
        <texture name="T_Wood_studyTable" type="cube" height="1" width="1" file="assets/studyTable/textures/wood0.png"/>
        <texture name="T_Metal_studyTable" type="cube" height="1" width="1" file="assets/studyTable/textures/metal0.png"/>
        <material name="M_Wood_studyTable" texture="T_Wood_studyTable" rgba="0.8 0.8 0.8 1" shininess="0.2" reflectance="0.3" texuniform="false"/>
        <material name="M_Metal_studyTable" texture="T_Metal_studyTable" texrepeat="3 3" reflectance="0.7" texuniform="false"/>
        
        <!-- StudyTable meshes -->
        <mesh name="studyTable_Main" file="assets/studyTable/meshes/studyTable_Main.stl" scale="0.01 0.01 0.01"/>
        <mesh name="studyTable_Slide_Wood" file="assets/studyTable/meshes/studyTable_Slide_Wood.stl" scale="0.01 0.01 0.01"/>
        <mesh name="studyTable_Slide_Handle" file="assets/studyTable/meshes/studyTable_Slide_Handle.stl" scale="0.01 0.01 0.01"/>
