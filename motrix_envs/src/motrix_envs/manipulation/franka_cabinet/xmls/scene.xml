<?xml version="1.0" ?>
<!-- 
MotrixLab Franka Cabinet 环境
Franka Panda 机械臂配合平行夹爪，用于抽屉开启任务
基于 Isaac Lab 的 "Isaac-Franka-Cabinet-Direct-v0" 实现
-->
<mujoco model="franka_cabinet_scene">
    
    <compiler angle="radian" autolimits="true"/>
    
    <!-- 使用 implicit 积分器以提高关节机器人的稳定性 -->
    <!-- 较小的时间步长 (0.005) 用于数值稳定性 -->
    <option integrator="implicit" timestep="0.005"/>
    
    <!-- Franka Panda 默认参数 -->
    <!-- 增大 armature (0.1 -> 0.5) 和 damping (1 -> 5) 以提高稳定性 -->
    <default>
        <default class="panda">
            <material specular="0.5" shininess="0.25"/>
            <joint armature="0.5" damping="5" axis="0 0 1" range="-2.8973 2.8973"/>
            <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
            <default class="finger">
                <!-- 增大手指关节 armature 以在 MotrixSim 中正则化惯性矩阵 -->
                <joint axis="0 1 0" type="slide" range="0 0.04" armature="0.05"/>
            </default>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>
            <default class="collision">
                <geom type="mesh" group="3"/>
                <default class="fingertip_pad_collision_1">
                    <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
                </default>
                <default class="fingertip_pad_collision_2">
                    <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_3">
                    <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_4">
                    <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
                </default>
                <default class="fingertip_pad_collision_5">
                    <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
                </default>
            </default>
        </default>
        
        <!-- Sektion Cabinet 默认参数 -->
        <default class="cabinet">
            <joint damping="0.5" armature="0.01"/>
            <geom friction="1.0 0.005 0.0001" condim="3"/>
        </default>
        <default class="cabinet_collision">
            <!-- 柜体 geom 目前仅定义为碰撞体；为在默认查看器中可见，
                 将其渲染在 group 2（与机器人视觉 geom 相同）。 -->
            <geom group="2"/>
        </default>
        <default class="door">
            <!-- 增大 damping (0.05->5.0) 和 friction (0.025->0.5) 以防止门自由摆动 -->
            <joint type="hinge" damping="5.0" frictionloss="0.5" armature="0.01"/>
        </default>
        <default class="drawer">
            <!-- 增大 damping (0.01->2.0) 和 friction (0.01->0.2) 以防止抽屉漂移 -->
            <joint type="slide" damping="2.0" frictionloss="0.2" armature="0.01"/>
        </default>
    </default>

    <asset>
        <!-- Franka Panda 材质 -->
        <material class="panda" name="white" rgba="1 1 1 1"/>
        <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
