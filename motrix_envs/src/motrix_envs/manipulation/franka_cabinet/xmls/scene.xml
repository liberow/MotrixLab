<?xml version="1.0" ?>
<!-- 
Franka Cabinet Environment for MotrixLab
Franka Panda robot with parallel gripper, adapted for drawer opening task
Based on Isaac Lab's "Isaac-Franka-Cabinet-Direct-v0"
-->
<mujoco model="franka_cabinet_scene">
    
    <compiler angle="radian" autolimits="true"/>
    
    <!-- Use implicit integrator for better stability with articulated robots -->
    <!-- Smaller timestep (0.005) for numerical stability -->
    <option integrator="implicit" timestep="0.005"/>
    
    <!-- Franka Panda defaults -->
    <!-- Increased armature (0.1 -> 0.5) and damping (1 -> 5) for stability -->
    <default>
        <default class="panda">
            <material specular="0.5" shininess="0.25"/>
            <joint armature="0.5" damping="5" axis="0 0 1" range="-2.8973 2.8973"/>
            <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
            <default class="finger">
                <!-- Increase finger joint armature to further regularize inertia matrix in MotrixSim -->
                <joint axis="0 1 0" type="slide" range="0 0.04" armature="0.05"/>
            </default>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>
            <default class="collision">
                <geom type="mesh" group="3"/>
                <default class="fingertip_pad_collision_1">
                    <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
                </default>
                <default class="fingertip_pad_collision_2">
                    <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_3">
                    <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_4">
                    <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
                </default>
                <default class="fingertip_pad_collision_5">
                    <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
                </default>
            </default>
        </default>
        
        <!-- Sektion Cabinet defaults -->
        <default class="cabinet">
            <joint damping="0.5" armature="0.01"/>
            <geom friction="1.0 0.005 0.0001" condim="3"/>
        </default>
        <default class="cabinet_collision">
            <!-- Cabinet geoms are currently only defined as collision shapes; to make the
                 cabinet visible in the default viewer, render them in group 2 (same as
                 the robot visual geoms). -->
            <geom group="2"/>
        </default>
        <default class="door">
            <!-- Increased damping (0.05->5.0) and friction (0.025->0.5) to prevent free swinging -->
            <joint type="hinge" damping="5.0" frictionloss="0.5" armature="0.01"/>
        </default>
        <default class="drawer">
            <!-- Increased damping (0.01->2.0) and friction (0.01->0.2) to prevent drift -->
            <joint type="slide" damping="2.0" frictionloss="0.2" armature="0.01"/>
        </default>
    </default>

    <asset>
        <!-- Franka Panda materials -->
        <material class="panda" name="white" rgba="1 1 1 1"/>
        <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
        <material class="panda" name="black" rgba="0.25 0.25 0.25 1"/>
        <material class="panda" name="green" rgba="0 1 0 1"/>
        <material class="panda" name="light_blue" rgba="0.039216 0.541176 0.780392 1"/>
        
        <!-- Sektion Cabinet materials -->
        <material name="cabinet_white" rgba="0.85 0.85 0.85 1"/>
        <material name="cabinet_grey" rgba="0.6 0.6 0.6 1"/>
        <material name="cabinet_front" rgba="0.4 0.4 0.4 1"/>
        
