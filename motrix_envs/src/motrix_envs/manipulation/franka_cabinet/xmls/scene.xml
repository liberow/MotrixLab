            <geom name="sektion_collision5" type="mesh" mesh="sektion_convexdecomposition5" class="cabinet_collision"/>
            <geom name="sektion_collision6" type="mesh" mesh="sektion_convexdecomposition6" class="cabinet_collision"/>
            
            <!-- ==================== 右门 ==================== -->
            <!-- 关节索引：0 (door_right_joint) - 遵循 sektion_cabinet_2.xml 顺序 -->
            <body name="door_right_link" pos="0.3162 0.3757 -0.12973">
                <inertial mass="1.0" pos="0 -0.18 0" diaginertia="0.01 0.01 0.01"/>
                <joint name="door_right_joint" type="hinge" axis="0 0 1"
                       range="0 1.57" class="door"/>
                <!-- 门碰撞体 -->
                <geom name="door_right_collision" type="mesh" mesh="door_right"
                      pos="0 -0.184706 0" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <!-- 门把手碰撞体 -->
                <geom name="door_right_nob_collision" type="mesh" mesh="door_right_nob"
                      pos="0 -0.184706 0" rgba="0.6 0.6 0.6 1" class="cabinet_collision"/>
                <site name="door_right_handle" type="sphere" size="0.015"
                      pos="0.02 -0.02 0" rgba="1 1 0 0.5"/>
            </body>
            
            <!-- ==================== 左门 ==================== -->
            <!-- 关节索引：1 (door_left_joint) -->
            <body name="door_left_link" pos="0.3162 -0.3757 -0.12973">
                <inertial mass="1.0" pos="0 0.18 0" diaginertia="0.01 0.01 0.01"/>
                <joint name="door_left_joint" type="hinge" axis="0 0 1"
                       range="-1.57 0" class="door"/>
                <!-- 门碰撞体 -->
                <geom name="door_left_collision" type="mesh" mesh="door_left"
                      pos="0 0.184706 0" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <!-- 门把手碰撞体 -->
                <geom name="door_left_nob_collision" type="mesh" mesh="door_left_nob"
                      pos="0 0.184706 0" rgba="0.6 0.6 0.6 1" class="cabinet_collision"/>
                <site name="door_left_handle" type="sphere" size="0.015"
                      pos="0.02 0.02 0" rgba="0 0 1 0.5"/>
            </body>
            
            <!-- ==================== 顶部抽屉 ==================== -->
            <!-- 关节索引：2 (drawer_top_joint) - 主要任务目标 -->
            <!-- 这是 Isaac Lab 中 cabinet_dof_pos[:, 3] 引用的抽屉 -->
            <body name="drawer_top" pos="0.0515 0 0.3172">
                <inertial mass="0.5" pos="0.15 0 0" diaginertia="0.005 0.005 0.005"/>
                <!-- 降低 damping/friction 以匹配 Isaac Lab (damping=1.0)，使抽屉更容易拉动 -->
                <joint name="drawer_top_joint" type="slide" axis="1 0 0" 
                       range="0 0.4" class="drawer"
                       damping="1.0" frictionloss="0.5" armature="0.01"/>
                <!-- 抽屉本体碰撞（凸分解） -->
                <geom name="drawer_top_collision0" type="mesh" mesh="drawer_convexdecomposition0" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <geom name="drawer_top_collision1" type="mesh" mesh="drawer_convexdecomposition1" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <geom name="drawer_top_collision2" type="mesh" mesh="drawer_convexdecomposition2" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <geom name="drawer_top_collision3" type="mesh" mesh="drawer_convexdecomposition3" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <geom name="drawer_top_collision4" type="mesh" mesh="drawer_convexdecomposition4" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <geom name="drawer_top_collision5" type="mesh" mesh="drawer_convexdecomposition5" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <geom name="drawer_top_collision6" type="mesh" mesh="drawer_convexdecomposition6" rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <!-- 抽屉把手碰撞体（降低摩擦以匹配 Isaac Lab） -->
                <geom name="drawer_handle_top_collision" type="mesh" mesh="drawer_handle_convexdecomposition" 
                      rgba="0.6 0.6 0.6 1" class="cabinet_collision" friction="1.0 0.3 0.0001"/>
                <!-- 主要抓取目标位置标记 -->
                <site name="drawer_top_handle" type="sphere" size="0.02" 
                      pos="0.303 0 0.01" rgba="1 0 0 0.8"/>
            </body>
            
            <!-- ==================== 底部抽屉 ==================== -->
            <!-- 关节索引：3 (drawer_bottom_joint) -->
            <body name="drawer_bottom" pos="0.0515 0 0.18795">
                <inertial mass="0.5" pos="0.15 0 0" diaginertia="0.005 0.005 0.005"/>
                <!-- 底部抽屉使用稍高的阻尼以保持静止 -->
                <joint name="drawer_bottom_joint" type="slide" axis="1 0 0"
                       range="0 0.4" class="drawer"
                       damping="2.0" frictionloss="1.0" armature="0.01"/>
                <!-- 抽屉本体碰撞 -->
                <geom name="drawer_bottom_collision" type="mesh" mesh="drawer_convexdecomposition" 
                      rgba="0.4 0.4 0.4 1" class="cabinet_collision"/>
                <!-- 抽屉把手碰撞体 -->
                <geom name="drawer_handle_bottom_collision" type="mesh" mesh="drawer_handle_convexdecomposition"
                      rgba="0.6 0.6 0.6 1" class="cabinet_collision" friction="1.0 0.3 0.0001"/>
                <site name="drawer_bottom_handle" type="sphere" size="0.015"
                      pos="0.303 0 0.01" rgba="0 1 0 0.5"/>
            </body>
            
        </body>
    </worldbody>

    <!-- 夹爪手指腱用于同步控制 -->
    <tendon>
        <fixed name="split">
            <joint joint="panda_finger_joint1" coef="0.5"/>
            <joint joint="panda_finger_joint2" coef="0.5"/>
        </fixed>
    </tendon>

    <!-- 夹爪等式约束
         注意：panda 手指已通过上面的 'split' 腱耦合。
         为避免冗余约束导致 MotrixSim 冲量求解器中惯性矩阵非正定，
         我们在此故意移除额外的关节等式约束。 -->

    <!-- 执行器（9 自由度：7 臂关节 + 1 耦合夹爪通过腱控制）
         使用较低增益以匹配 Isaac Lab 的 ImplicitActuator (stiffness=80, damping=4)
         这可以防止高增益位置控制导致的不稳定 -->
    <actuator>
        <!-- 肩部关节 (1-4)：effort_limit=87, stiffness=80, damping=4 -->
        <general class="panda" name="actuator1" joint="panda_joint1" gainprm="80" biasprm="0 -80 -4" forcerange="-87 87"/>
        <general class="panda" name="actuator2" joint="panda_joint2" gainprm="80" biasprm="0 -80 -4" forcerange="-87 87"
            ctrlrange="-1.7628 1.7628"/>
        <general class="panda" name="actuator3" joint="panda_joint3" gainprm="80" biasprm="0 -80 -4" forcerange="-87 87"/>
        <general class="panda" name="actuator4" joint="panda_joint4" gainprm="80" biasprm="0 -80 -4" forcerange="-87 87"
            ctrlrange="-3.0718 -0.0698"/>
        <!-- 前臂关节 (5-7)：effort_limit=12, stiffness=80, damping=4 -->
        <general class="panda" name="actuator5" joint="panda_joint5" gainprm="80" biasprm="0 -80 -4" forcerange="-12 12"/>
        <general class="panda" name="actuator6" joint="panda_joint6" gainprm="80" biasprm="0 -80 -4" forcerange="-12 12"
            ctrlrange="-0.0175 3.7525"/>
        <general class="panda" name="actuator7" joint="panda_joint7" gainprm="80" biasprm="0 -80 -4" forcerange="-12 12"/>
        <!-- 夹爪执行器通过腱控制（较高刚度用于抓取，匹配 Isaac Lab stiffness=2000） -->
        <general class="panda" name="actuator8" tendon="split" forcerange="-200 200" ctrlrange="0 255"
            gainprm="0.01568627451 0 0" biasprm="0 -100 -10"/>
    </actuator>

    <!-- 柜子关节位置传感器（匹配 sektion_cabinet_2 顺序） -->
    <sensor>
        <jointpos name="door_right_pos" joint="door_right_joint"/>
        <jointpos name="door_left_pos" joint="door_left_joint"/>
        <jointpos name="drawer_top_pos" joint="drawer_top_joint"/>
        <jointpos name="drawer_bottom_pos" joint="drawer_bottom_joint"/>
        
        <jointvel name="door_right_vel" joint="door_right_joint"/>
        <jointvel name="door_left_vel" joint="door_left_joint"/>
        <jointvel name="drawer_top_vel" joint="drawer_top_joint"/>
        <jointvel name="drawer_bottom_vel" joint="drawer_bottom_joint"/>
    </sensor>

    <!-- 初始状态 keyframe（来自 Isaac Lab FrankaCabinetEnv） -->
    <!-- qpos 顺序：7 臂关节 + 2 手指关节 + 4 柜子关节 -->
    <!-- 机器人关节：panda_joint1-7, panda_finger_joint1-2 -->
    <!-- 柜子关节（sektion_cabinet_2 顺序）：door_right, door_left, drawer_top, drawer_bottom（全部关闭 = 0） -->
    <keyframe>
        <key name="home" 
             qpos="1.157 -1.066 -0.155 -2.239 -1.841 1.003 0.469 0.035 0.035 0 0 0 0" 
             ctrl="1.157 -1.066 -0.155 -2.239 -1.841 1.003 0.469 255"/>
        <key name="drawer_open" 
             qpos="1.157 -1.066 -0.155 -2.239 -1.841 1.003 0.469 0.035 0.035 0 0 0.39 0" 
             ctrl="1.157 -1.066 -0.155 -2.239 -1.841 1.003 0.469 255"/>
    </keyframe>
</mujoco>
